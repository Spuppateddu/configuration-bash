# Git
alias gs="git status"
alias gp="git pull"

# Machine-local, untracked aliases (SSH hosts, secrets, machine-specific paths)
BASH_ALIAS_LOCAL="$BASH_CONFIG_DIR/bash-alias.local"
[ -f "$BASH_ALIAS_LOCAL" ] && . "$BASH_ALIAS_LOCAL"
unset BASH_ALIAS_LOCAL
