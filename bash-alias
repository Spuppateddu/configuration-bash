# Adding an alias? Not here: ~/best-linux-environment/aliases (every machine) or
# ~/best-linux-environment/aliases.local (this machine) — that repo is the one place.

# bashrc sets this before sourcing us; the fallback keeps the file usable alone.
BASH_CONFIG_DIR="${BASH_CONFIG_DIR:-$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}"

# Machine-local, untracked lines (best-linux-environment's chrome-headless writes
# its exports here).
BASH_ALIAS_LOCAL="$BASH_CONFIG_DIR/bash-alias.local"
[ -f "$BASH_ALIAS_LOCAL" ] && . "$BASH_ALIAS_LOCAL"
unset BASH_ALIAS_LOCAL
